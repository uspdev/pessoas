APP_NAME=Pessoas
APP_KEY=
APP_URL=http://127.0.0.1:8000
APP_ENV=local
APP_DEBUG=true

LOG_CHANNEL=stack

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=pessoas
DB_USERNAME=pessoas
DB_PASSWORD=pessoas

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=test@example.com
MAIL_FROM_NAME="Laravel"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SENHAUNICA_KEY=faker
SENHAUNICA_SECRET=faker
SENHAUNICA_CALLBACK_ID=1
SENHAUNICA_ADMINS=111111
SENHAUNICA_DEV="http://auth.local:3141/wsusuario/oauth"
SENHAUNICA_CODIGO_UNIDADE=

REPLICADO_HOST=
REPLICADO_PORT=
REPLICADO_DATABASE=
REPLICADO_USERNAME=
REPLICADO_PASSWORD=
REPLICADO_FAKE=1
# Desliga ou liga consultas ao replicado, mesmo que ele exista no composer.json (default = true)
SENHAUNICA_USAR_REPLICADO=false

# Código da unidade
REPLICADO_CODUNDCLG=

# Todos os códigos de colegiados da unidade, separados por vírgula
REPLICADO_CODUNDCLGS=${REPLICADO_CODUNDCLG}

# WSFOTO
# https://github.com/uspdev/wsfoto
WSFOTO_USER=
WSFOTO_PASS=
# Ative a funcionalidade do wsfoto (foto fake apenas).
WSFOTO_DISABLE=1

# Caso a biblioteca retorne sempre a foto fake, pode estar tendo
# algum problema na biblioteca. Ative o debug para ver os erros.
#WSFOTO_DEBUG=0

# Caminho para o arquivo de imagem desejada para ser utilizada
# como a foto fake
WS_FOTO_FAKE_PATH=

# Mostra a foto lattes da pessoa
MOSTRAR_FOTO_LATTES=false

# Dusk
APP_URL=http://pessoas
DUSK_DRIVER_URL='http://selenium:4444/wd/hub'
DUSK_START_MAXIMIZED=true
DUSK_HEADLESS_DISABLED=true

USP_THEME_SKIN=uspdev
